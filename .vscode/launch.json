{
    // STM32Cube Debug
    // Requier STM32Cube Debug STLink GDB Server extention and dependency
    // Easy setup, just install extention in vscode and run.
    // Optionall install STM2Cube Register View extention for registers tree view
    "version": "0.2.0",
    "configurations": [
        {
            "type": "stlinkgdbtarget",
            "request": "launch",
            "name": "STM32Cube: STM32 Launch ST-Link GDB Server",
            "origin": "snippet",
            "cwd": "${workspaceFolder}/nuttx",
            "preBuild": "build",
            "runEntry": "main",
            "deviceName": "STM32H753ZIT6",
            "deviceCore": "Cortex-M7",
            "imagesAndSymbols": [
                {
                    "imageFileName": "${workspaceFolder}/nuttx/nuttx"
                }
            ],
            "preLaunchTask": "Build"
        },
        // Need J-Link 
        // Not tested yet
        {
            "name": "J-Link",
            "cwd": "${workspaceRoot}",
            "executable": "${workspaceFolder}/nuttx/nuttx",
            "request": "launch",
            "type": "cortex-debug",
            "device": "stm32h753zi",
            "interface": "swd",
            "runToEntryPoint": "main",
            "servertype": "jlink",
            "liveWatch": {
                "enabled": true,
                "samplesPerSecond": 4
            },
            "preLaunchTask": "Build",
        },
        // Need stutil installed. 
        // Recommend ST-Link with STM32CubeCLT instead
        {
            "name": "ST-Util",
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/nuttx/nuttx",
            "request": "launch",
            "type": "cortex-debug",
            "servertype": "stutil",
            "serverArgs": [
                "--freq=8000k"
            ],
            "device": "stm32h753zi",
            "interface": "swd",
            "svdFile": "",
            "swoConfig": {}
        },
        // ST-Link - Debug requiers ST-Link installed.
        // Recommend STM32CubeCLT https://www.st.com/en/development-tools/stm32cubeclt.html
        // Add STM32CubeCLT path in settings and your PATH env.
        // Install cortex-debug extention and configure in settings
        {
            "name": "ST-Link - Debug",
            "device": "stm32h753zi",
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/nuttx/nuttx",
            "interface": "swd",
            "request": "launch",
            "type": "cortex-debug",
            "runToEntryPoint": "main",
            "servertype": "stlink",
            "serverArgs": [
                "-v",
                "-t",
                "-s",
                "-m",
                "0",
                "-k",
                "--frequency",
                "8000"
            ],
            "liveWatch": {
                "enabled": true,
                "samplesPerSecond": 4
            },
            "preLaunchTask": "Build",
            "showDevDebugOutput": "raw"
        },
    ]
}