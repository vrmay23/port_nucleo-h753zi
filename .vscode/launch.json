{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "type": "stlinkgdbtarget",
            "request": "launch",
            "name": "STM32Cube: STM32 Launch ST-Link GDB Server",
            "origin": "snippet",
            "cwd": "${workspaceFolder}/nuttx",
            "preBuild": "build",
            "runEntry": "main",
            "deviceName": "STM32H753ZIT6",
            "deviceCore": "Cortex-M7",
            "imagesAndSymbols": [
                {
                    "imageFileName": "${workspaceFolder}/nuttx/nuttx"
                }
            ]
        },
        {
            "name": "J-Link",
            "cwd": "${workspaceRoot}",
            "executable": "${workspaceFolder}/nuttx/nuttx",
            "request": "launch",
            "type": "cortex-debug",
            "device": "stm32h753zi",
            "interface": "swd",
            "runToEntryPoint": "main",
            "servertype": "jlink",
            "liveWatch": {
                "enabled": true,
                "samplesPerSecond": 4
            },
            "preLaunchTask": "Build",
        },
        {
            "name": "ST-Link",
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/nuttx/nuttx",
            "request": "launch",
            "type": "cortex-debug",
            "servertype": "stutil",
            "serverArgs": [
                "--freq=8000k"
            ],
            "device": "stm32h753zi",
            // "device": "stm32f746g",
            // "device": "stm32f401rc",
            "interface": "swd",
            "svdFile": "",
            "swoConfig": {}
        },
        {
            "name": "ST-Link - Debug",
            "device": "stm32h753zi",
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/nuttx/nuttx",
            "interface": "swd",
            "request": "launch",
            "type": "cortex-debug",
            "runToEntryPoint": "main",
            "servertype": "stlink",
            "serverArgs": [
                "-s",
                "-m",
                "0",
                "-k",
                "--frequency",
                "8000"
            ],
            "liveWatch": {
                "enabled": true,
                "samplesPerSecond": 4
            },
            "preLaunchTask": "Build",
            "showDevDebugOutput": "raw"
        },
                {
            "name": "Tobias ST-Link - Debug",
            "device": "stm32h753zi",
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/nuttx/nuttx",
            "interface": "swd",
            "request": "launch",
            "type": "cortex-debug",
            //"runToEntryPoint": "main",
            "servertype": "stlink",
            "serverArgs": [
                "-v",
                "-t",
            ],
            "liveWatch": {
                "enabled": true,
                "samplesPerSecond": 4
            },
            "preLaunchTask": "Build",
            "showDevDebugOutput": "raw"
        },
    ]
}